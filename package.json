{
  "name": "voice",
  "productName": "Voice",
  "version": "0.2.0",
  "description": "Peer-to-peer, end-to-end encrypted voice and chat without accounts or servers. Low-latency, high-bitrate Opus.",
  "main": "src/main/main.js",
  "license": "GPL-3.0-only",
  "author": "Voice contributors",
  "homepage": "https://github.com/hjulijulijubin/voice",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "test": "node --test \"test/*.test.*\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:e2e": "node test/e2e/p2p.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.64.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "io.github.hjulijulijubin.voice",
    "productName": "Voice",
    "copyright": "GPL-3.0 Voice contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voice uses your microphone for voice chat."
      },
      "identity": "-"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "synopsis": "Peer-to-peer voice and chat",
      "maintainer": "Voice contributors <noreply@github.com>",
      "mimeTypes": [
        "x-scheme-handler/voice"
      ]
    },
    "publish": null,
    "protocols": [
      {
        "name": "Voice invite",
        "schemes": [
          "voice"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
